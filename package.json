{
  "name": "vouchit",
  "private": true,
  "version": "1.0.0",
  "description": "Share and exchange vouchers with your community. Find great deals and help others save money.",
  "type": "module",
  "author": "VouchIt Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/heykay-47/vouchit.git"
  },
  "bugs": {
    "url": "https://github.com/heykay-47/vouchit/issues"
  },
  "homepage": "https://vouchit.vercel.app/",
  "keywords": [
    "vouchers",
    "deals",
    "discounts",
    "community",
    "sharing",
    "react",
    "vite"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:production": "vite build --mode production",
    "build:analyze": "npm run build && npx --yes vite-bundle-analyzer dist",
    "build:size": "npm run build && echo 'Build completed. Check dist/ folder size manually.'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port 8080",
    "security:audit": "npm audit",
    "security:audit-fix": "npm audit fix",
    "security:check": "npm run security:audit && npm run lint",
    "type-check": "tsc --build --dry --force",
    "clean": "rimraf dist node_modules/.vite",
    "test:security": "npm run security:check && npm run type-check",
    "install:devtools": "npm install --save-dev @tanstack/react-query-devtools@^5.56.2",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.56.2",
    "@tanstack/react-virtual": "^3.2.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^0.7.0",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.3.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "framer-motion": "^12.5.0",
    "helmet": "^8.2.0",
    "input-otp": "^1.2.4",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.462.0",
    "mongoose": "^8.8.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-intersection-observer": "^9.16.0",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@swc/core": "^1.11.13",
    "@tailwindcss/typography": "^0.5.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "cssnano": "^6.1.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "rimraf": "^6.1.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.11",
    "terser": "^5.39.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "vite": {
      "esbuild": "^0.25.0"
    }
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
